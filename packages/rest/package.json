{
  "name": "@vestra/rest",
  "version": "0.0.0",
  "description": "Discord REST client with bucket-accurate rate limiting",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CustomRL/Vestra.git",
    "directory": "packages/rest"
  },
  "homepage": "https://github.com/CustomRL/Vestra#readme",
  "bugs": {
    "url": "https://github.com/CustomRL/Vestra/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "check:packaging": "publint --strict && attw --pack . --profile esm-only"
  },
  "keywords": [
    "discord",
    "discord-api",
    "bot",
    "typescript"
  ],
  "dependencies": {
    "@vestra/types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
