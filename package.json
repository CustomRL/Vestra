{
  "name": "vestra-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CustomRL/Vestra.git"
  },
  "homepage": "https://github.com/CustomRL/Vestra#readme",
  "bugs": {
    "url": "https://github.com/CustomRL/Vestra/issues"
  },
  "type": "module",
  "description": "A lightweight, fully-typed Discord library for Node.js",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test --test-timeout=60000 \"tests/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test --test-timeout=60000 \"tests/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "check:packaging": "turbo run check:packaging",
    "check:drift": "node --experimental-strip-types scripts/check-api-drift.ts",
    "bench": "node --experimental-strip-types --expose-gc --allow-natives-syntax",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vestra/core": "workspace:*",
    "@vestra/gateway": "workspace:*",
    "@vestra/rest": "workspace:*",
    "@vestra/types": "workspace:*",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tsdoc": "0.5.2",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vestra": "workspace:*"
  }
}
